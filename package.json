{
  "name": "reveal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "description": "Review your Readmoo book highlights: full-screen quotes, a looping ruler, folders, tags, rich-text edits. Runs offline; data stays in your browser.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "bun run typecheck && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26",
    "serve": "^14.2.8",
    "typescript": "^5.7",
    "vitest": "5.1.0"
  }
}
